{
  "name": "wrappedbtc-reward-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auto-claim Pump creator rewards, swap SOL to WBTC, and distribute equally to eligible holders.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:all": "npm run build && node scripts/start-all.mjs",
    "overlay": "node dist/overlay.js",
    "overlay:dev": "tsx src/overlay.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@pump-fun/pump-sdk": "^1.32.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@vercel/kv": "^3.0.0",
    "bn.js": "^5.2.3",
    "bs58": "^6.0.0",
    "chalk": "^5.4.1",
    "dotenv": "^16.5.0",
    "localtunnel": "^2.0.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
